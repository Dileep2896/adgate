# Copy to .env and fill in, then start the app with:
#
#   uvicorn app.main:app --reload --port 8000 --env-file .env
#
# There is no dotenv dependency: uvicorn's --env-file is what loads this file. Exporting the
# same variables in your shell works just as well, and is what the README shows.

# The app id printed by `pnpm --filter @adgateio/gateway create-app --name fastapi-demo`.
ADGATE_APP_ID=app_...

# The app-role API key printed once by the same command; only its argon2id hash is stored.
# Server side only: the browser never sees it, and the page never calls the gateway directly.
ADGATE_API_KEY=ak_..._...

# Where the gateway listens. Default http://localhost:8787.
ADGATE_BASE_URL=http://localhost:8787

# Milliseconds between the offline model's tokens. Default 35; 0 makes the stream instant.
# MOCK_CHUNK_DELAY_MS=35

# --- Language model (all optional) -------------------------------------------------------
# With none of these set the example uses the offline canned model in app/mock_model.py:
# three answers picked by keyword, streamed word by word. No API key and no network needed.
#
# Set OPENAI_API_KEY to stream from a real OpenAI-compatible endpoint instead.
# OPENAI_API_KEY=sk-...
# Any endpoint that speaks the OpenAI chat completions protocol (Ollama, vLLM, OpenRouter ...).
# OPENAI_BASE_URL=https://api.openai.com/v1
# Default gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini
