# Copy to .env.local (git ignored) and fill in. Next.js loads it automatically.

# The app id printed by `pnpm --filter @adgateio/gateway create-app --name nextjs-demo`.
ADGATE_APP_ID=app_...

# The app-role API key printed by the same command. Shown once; only its argon2id hash is stored.
# Server side only: it is never sent to the browser.
ADGATE_API_KEY=ak_..._...

# Where the gateway listens. Default http://localhost:8787.
ADGATE_BASE_URL=http://localhost:8787

# The example serves on 3001 (the dashboard owns 3000). To move it, set PORT in the SHELL, not
# here: the dev script reads it before Next loads this file. PORT=3005 pnpm --filter nextjs-chat dev

# --- Language model (all optional) -------------------------------------------------------
# With none of these set the example uses the offline mock model in lib/mock-model.ts: canned
# answers picked by keyword, streamed word by word. No API key and no network needed.
#
# Set OPENAI_API_KEY to use a real OpenAI-compatible endpoint instead.
# OPENAI_API_KEY=sk-...
# Any endpoint that speaks the OpenAI chat protocol (Ollama, vLLM, OpenRouter, Azure ...).
# OPENAI_BASE_URL=https://api.openai.com/v1
# Default gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini
