{
  "name": "@adgateio/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure classify, policy, demand and audit logic. Not published: only the private gateway and dashboard consume it.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@adgateio/schemas": "workspace:*"
  }
}
