{
  "name": "@adgate/schemas",
  "version": "0.1.0",
  "description": "The adgate contract as Zod schemas and JSON Schema: evaluate, policy, audit record, verify. Runtime dependency of @adgate/sdk.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/adgate/adgate/tree/main/packages/schemas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adgate/adgate.git",
    "directory": "packages/schemas"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "json"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "gen:json": "tsx src/gen-json.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
}
