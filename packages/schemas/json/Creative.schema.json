{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A sponsored creative to render in a separate labeled block after the answer.",
  "properties": {
    "id": {
      "description": "Identifier with the \"cr_\" prefix.",
      "minLength": 4,
      "pattern": "^cr_.*",
      "title": "CreativeId",
      "type": "string"
    },
    "advertiser": {
      "description": "Advertiser display name.",
      "minLength": 1,
      "type": "string"
    },
    "headline": {
      "minLength": 1,
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "cta": {
      "description": "Call-to-action label.",
      "minLength": 1,
      "type": "string"
    },
    "url": {
      "description": "Always the gateway click redirect (/c/:audit_id), never the advertiser directly.",
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "description": "Demand source that supplied a creative (see docs/policy.md demand list).",
      "enum": [
        "direct",
        "affiliate",
        "koah",
        "gravity"
      ],
      "title": "DemandSource",
      "type": "string"
    },
    "disclosure_label": {
      "description": "Label the SDK must render, e.g. Sponsored.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "advertiser",
    "headline",
    "body",
    "cta",
    "url",
    "source",
    "disclosure_label"
  ],
  "title": "Creative",
  "type": "object"
}
