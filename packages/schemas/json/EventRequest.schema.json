{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Body of POST /v1/events. Returns 204. Duplicate impressions for the same audit_id are ignored.",
  "properties": {
    "audit_id": {
      "description": "Identifier with the \"aud_\" prefix.",
      "minLength": 5,
      "pattern": "^aud_.*",
      "title": "AuditId",
      "type": "string"
    },
    "type": {
      "enum": [
        "impression",
        "click",
        "dismiss",
        "conversion"
      ],
      "title": "EventType",
      "type": "string"
    },
    "ts": {
      "description": "ISO 8601 timestamp in UTC, e.g. 2026-09-02T18:04:11Z.",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "title": "IsoTimestamp",
      "type": "string"
    },
    "meta": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "audit_id",
    "type",
    "ts"
  ],
  "title": "EventRequest",
  "type": "object"
}
