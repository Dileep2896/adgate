{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One conversation turn. Servers truncate to the last 4 messages and 4,000 characters before classification.",
  "properties": {
    "role": {
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ],
      "title": "MessageRole",
      "type": "string"
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "role",
    "content"
  ],
  "title": "Message",
  "type": "object"
}
