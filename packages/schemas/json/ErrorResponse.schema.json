{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Body of every 4xx/5xx response from endpoints other than /v1/evaluate.",
  "properties": {
    "error": {
      "properties": {
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    }
  },
  "required": [
    "error"
  ],
  "title": "ErrorResponse",
  "type": "object"
}
