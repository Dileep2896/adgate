{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "properties": {
        "messages": {
          "minItems": 1
        }
      },
      "required": [
        "messages"
      ]
    },
    {
      "required": [
        "context_summary"
      ]
    }
  ],
  "description": "Body of POST /v1/evaluate.",
  "properties": {
    "app_id": {
      "description": "Identifier with the \"app_\" prefix.",
      "minLength": 5,
      "pattern": "^app_.*",
      "title": "AppId",
      "type": "string"
    },
    "conversation_id": {
      "description": "App-side conversation id. Stored only as a salted hash.",
      "minLength": 1,
      "type": "string"
    },
    "turn_id": {
      "minLength": 1,
      "type": "string"
    },
    "user": {
      "description": "The end user of the app for this turn.",
      "properties": {
        "tier": {
          "description": "free or paid. Apps may add other strings; anything not in serve_to_tiers is suppressed.",
          "minLength": 1,
          "type": "string"
        },
        "region": {
          "description": "ISO 3166 alpha-2 country code. Optional; when absent the regions rule fails closed and the turn is suppressed with reason region_blocked.",
          "pattern": "^[A-Z]{2}$",
          "type": "string"
        },
        "locale": {
          "description": "BCP 47 locale, e.g. en-US.",
          "minLength": 1,
          "type": "string"
        },
        "user_hash": {
          "description": "Optional stable per-user hash (sha256). Enables per_user_per_day frequency caps.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "tier"
      ],
      "title": "User",
      "type": "object"
    },
    "messages": {
      "description": "The last few turns, newest last. Required and non-empty unless context_summary is sent.",
      "items": {
        "description": "One conversation turn. Servers truncate to the last 4 messages and 4,000 characters before classification, and reject a single message over 32,768 characters.",
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ],
            "title": "MessageRole",
            "type": "string"
          },
          "content": {
            "maxLength": 32768,
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "Message",
        "type": "object"
      },
      "type": "array"
    },
    "context_summary": {
      "description": "Short summary sent instead of raw messages. Required unless messages is sent.",
      "minLength": 1,
      "type": "string"
    },
    "surface": {
      "description": "Where the sponsored slot would be rendered.",
      "properties": {
        "type": {
          "enum": [
            "chat",
            "agent",
            "cli"
          ],
          "title": "SurfaceType",
          "type": "string"
        },
        "placement": {
          "const": "after_answer",
          "description": "Always after_answer in v1.",
          "type": "string"
        },
        "max_creatives": {
          "description": "Upper bound on creatives to return. v1 returns at most one.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "placement"
      ],
      "title": "Surface",
      "type": "object"
    },
    "policy_overrides": {
      "additionalProperties": false,
      "description": "Partial PolicyConfig merged over the stored policy. May only make policy stricter.",
      "properties": {
        "version": {
          "const": 1,
          "type": "number"
        },
        "app_id": {
          "minLength": 1,
          "type": "string"
        },
        "serve_to_tiers": {
          "items": {
            "description": "A user tier name, e.g. free or paid.",
            "minLength": 1,
            "title": "PolicyTier",
            "type": "string"
          },
          "type": "array"
        },
        "allow_paid_tiers": {
          "type": "boolean"
        },
        "blocked_categories": {
          "items": {
            "description": "A sensitive topic that blocks ads. Matches fixtures/classify-fixtures.json.",
            "enum": [
              "health",
              "finance",
              "politics",
              "legal",
              "adult",
              "gambling",
              "weapons",
              "religion",
              "self_harm"
            ],
            "title": "SensitiveCategory",
            "type": "string"
          },
          "type": "array"
        },
        "sensitive_detection": {
          "description": "strict suppresses on any sensitive signal from rules OR the LLM.",
          "enum": [
            "strict",
            "balanced"
          ],
          "title": "SensitiveDetection",
          "type": "string"
        },
        "min_commercial_intent": {
          "description": "A score threshold between 0 and 1.",
          "maximum": 1,
          "minimum": 0,
          "title": "PolicyThreshold",
          "type": "number"
        },
        "min_confidence": {
          "description": "A score threshold between 0 and 1.",
          "maximum": 1,
          "minimum": 0,
          "title": "PolicyThreshold",
          "type": "number"
        },
        "competitor_exclusions": {
          "items": {
            "description": "An advertiser domain that must never be shown, e.g. competitor.com.",
            "minLength": 1,
            "title": "AdvertiserDomain",
            "type": "string"
          },
          "type": "array"
        },
        "frequency_caps": {
          "additionalProperties": false,
          "properties": {
            "per_session": {
              "description": "A frequency cap: a non-negative integer.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "title": "PolicyCap",
              "type": "integer"
            },
            "per_user_per_day": {
              "description": "A frequency cap: a non-negative integer.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "title": "PolicyCap",
              "type": "integer"
            },
            "min_turns_between": {
              "description": "A frequency cap: a non-negative integer.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "title": "PolicyCap",
              "type": "integer"
            }
          },
          "type": "object"
        },
        "disclosure": {
          "additionalProperties": false,
          "properties": {
            "label": {
              "description": "Label rendered on the sponsored block. Must be non-empty.",
              "minLength": 1,
              "title": "DisclosureLabel",
              "type": "string"
            },
            "position": {
              "const": "after_answer",
              "description": "Only after_answer exists in v1.",
              "title": "DisclosurePosition",
              "type": "string"
            },
            "style": {
              "const": "separate_block",
              "description": "Only separate_block exists in v1.",
              "title": "DisclosureStyle",
              "type": "string"
            }
          },
          "type": "object"
        },
        "demand": {
          "items": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "source": {
                    "const": "direct",
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "source"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "source": {
                    "const": "affiliate",
                    "type": "string"
                  },
                  "network": {
                    "description": "When omitted, every affiliate entry matches.",
                    "enum": [
                      "partnerstack",
                      "impact",
                      "amazon"
                    ],
                    "title": "AffiliateNetwork",
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "source"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "source": {
                    "const": "koah",
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "source"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "source": {
                    "const": "gravity",
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "source"
                ],
                "type": "object"
              }
            ],
            "title": "DemandEntryOverride"
          },
          "type": "array"
        },
        "privacy": {
          "additionalProperties": false,
          "properties": {
            "store_raw_text": {
              "type": "boolean"
            },
            "retain_days": {
              "description": "Retention window in days, at least 1.",
              "maximum": 9007199254740991,
              "minimum": 1,
              "title": "PolicyRetainDays",
              "type": "integer"
            }
          },
          "type": "object"
        },
        "regions": {
          "additionalProperties": false,
          "properties": {
            "allow": {
              "items": {
                "description": "ISO 3166-1 alpha-2 country code, or the token EU.",
                "pattern": "^[A-Z]{2}$",
                "title": "PolicyRegion",
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "title": "PolicyOverrides",
      "type": "object"
    }
  },
  "required": [
    "app_id",
    "conversation_id",
    "turn_id",
    "user",
    "surface"
  ],
  "title": "EvaluateRequest",
  "type": "object"
}
