{
  "name": "@adgate/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/db/schema.d.ts",
      "import": "./dist/db/schema.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./audit": {
      "types": "./dist/audit-read.d.ts",
      "import": "./dist/audit-read.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/server.ts src/admin.ts src/audit-read.ts src/db/schema.ts src/db/migrate.ts src/keygen.ts src/scripts/create-app.ts src/scripts/create-key.ts src/scripts/seed-creatives.ts src/scripts/load.ts --format esm --dts --sourcemap --clean",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "keygen": "tsx src/keygen.ts",
    "create-app": "tsx src/scripts/create-app.ts",
    "create-key": "tsx src/scripts/create-key.ts",
    "seed-creatives": "tsx src/scripts/seed-creatives.ts",
    "load": "tsx scripts/load.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@adgate/core": "workspace:*",
    "@adgate/schemas": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
