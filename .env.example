# Postgres (docker compose defaults)
# PGPORT_HOST: host port for the docker Postgres. Set to 5433 if a local Postgres already uses 5432
# (then use that port in the two URLs below).
# PGPORT_HOST=5432
DATABASE_URL=postgres://adgate:adgate@localhost:5432/adgate
DATABASE_URL_TEST=postgres://adgate:adgate@localhost:5432/adgate_test

# Gateway
PORT=8787
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8787
METRICS_TOKEN=change-me

# Audit signing (generate with: pnpm --filter @adgate/gateway keygen, added in S16)
ADGATE_SIGNING_KEY_ID=k_dev
ADGATE_SIGNING_KEY_PEM=
ADGATE_PUBLIC_KEYS_JSON={}

# Classifier (any OpenAI compatible chat completions endpoint; small fast model)
CLASSIFIER_BASE_URL=https://api.openai.com/v1
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=
CLASSIFIER_TIMEOUT_MS=400

# Dashboard
ADMIN_PASSWORD=change-me
