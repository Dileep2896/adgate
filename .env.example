# adgate environment. Copy to .env (git ignored) and edit. Every value below is a local dev default.

# --- Postgres (docker compose) ---
# PGPORT_HOST: host port docker compose publishes Postgres on. Set to 5433 if a native Postgres
# already owns 5432, then use that port in the two URLs below. CI and fresh clones keep 5432.
# PGPORT_HOST=5432
# DATABASE_URL: connection string for the gateway's main database (docker compose defaults).
DATABASE_URL=postgres://adgate:adgate@localhost:5432/adgate
# DATABASE_URL_TEST: separate database that integration tests use and truncate between tests.
# Created by scripts/db/init.sql on the first docker compose start. Never point it at real data.
DATABASE_URL_TEST=postgres://adgate:adgate@localhost:5432/adgate_test
# DB_STATEMENT_TIMEOUT_MS: Postgres statement_timeout set on every gateway connection, in ms. A query that
# runs longer is cancelled and the request fails closed (evaluate answers suppress/error). 0 disables it.
DB_STATEMENT_TIMEOUT_MS=2000
# DB_LOCK_TIMEOUT_MS: Postgres lock_timeout on every gateway connection, in ms: how long a request waits for
# the per-app audit chain lock before failing closed instead of hanging behind a stuck writer. 0 disables it.
DB_LOCK_TIMEOUT_MS=1000

# --- Gateway ---
# NODE_ENV: development | test | production. Informational for now (logged at boot).
NODE_ENV=development
# PORT: TCP port the Hono gateway listens on.
PORT=8787
# LOG_LEVEL: pino level: fatal | error | warn | info | debug | trace | silent. Logs are JSON lines on stdout.
LOG_LEVEL=info
# CORS_ALLOWED_ORIGINS: comma separated browser origins allowed to call the gateway.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# PUBLIC_BASE_URL: externally reachable base URL, used to build creative click URLs (/c/:audit_id).
PUBLIC_BASE_URL=http://localhost:8787
# METRICS_TOKEN: bearer token that protects the metrics endpoint.
METRICS_TOKEN=change-me
# RATE_LIMIT_RPS: sustained requests per second one API key may make to POST /v1/evaluate, /v1/attest and
# /v1/events together (a token bucket in Postgres refilled at this rate). Over the limit is 429 with Retry-After.
RATE_LIMIT_RPS=20
# RATE_LIMIT_BURST: how many requests one API key may make at once before the RATE_LIMIT_RPS refill applies
# (the bucket capacity). Set both high for load tests (packages/gateway/scripts/load.ts, docs/performance.md).
RATE_LIMIT_BURST=40

# --- Audit signing (Ed25519, see docs/audit.md) ---
# ADGATE_SIGNING_KEY_ID: identifier written into every signed audit record as key_id. Rotate by changing it.
ADGATE_SIGNING_KEY_ID=k_dev
# ADGATE_SIGNING_KEY_PEM: PKCS#8 PEM of the Ed25519 private key that signs audit records. REQUIRED: the
# gateway refuses to start while it is empty. Generate with: pnpm --filter @adgate/gateway keygen, which
# prints this line and the two around it ready to paste (double-quoted, line breaks as \n). Keep it out of git.
ADGATE_SIGNING_KEY_PEM=
# ADGATE_PUBLIC_KEYS_JSON: JSON object of key_id -> SPKI public key PEM used for verification, including retired keys.
# PEM line breaks are \n escapes inside the JSON string; parsed at boot by parsePublicKeysJson() in @adgate/core.
ADGATE_PUBLIC_KEYS_JSON={}

# --- Classifier (any OpenAI compatible chat completions endpoint; use a small fast model) ---
# Leave CLASSIFIER_MODEL (or CLASSIFIER_BASE_URL) empty to run the rules classifier only, with no LLM call.
# CLASSIFIER_BASE_URL: base URL of the chat completions API.
CLASSIFIER_BASE_URL=https://api.openai.com/v1
# CLASSIFIER_API_KEY: bearer token for that API. Empty sends no Authorization header (local endpoints). Unit tests never call it (the LLM is faked).
CLASSIFIER_API_KEY=
# CLASSIFIER_MODEL: model name sent to the endpoint, for example gpt-4o-mini.
CLASSIFIER_MODEL=
# CLASSIFIER_TIMEOUT_MS: hard timeout for one classification; exceeding it fails closed (decision suppress).
CLASSIFIER_TIMEOUT_MS=400

# --- Partner ad networks (stubs until partner API access exists, docs/decisions.md item 10) ---
# KOAH_ENABLED: true to let the Koah adapter be queried when an app's policy enables the koah demand source.
KOAH_ENABLED=false
# KOAH_API_KEY: Koah credential. A secret: never logged, persisted or written to audit records.
KOAH_API_KEY=
# KOAH_BASE_URL: Koah API base URL. Required alongside KOAH_API_KEY when KOAH_ENABLED is true.
KOAH_BASE_URL=
# GRAVITY_ENABLED: true to let the Gravity adapter be queried when an app's policy enables the gravity demand source.
GRAVITY_ENABLED=false
# GRAVITY_API_KEY: Gravity credential. A secret: never logged, persisted or written to audit records.
GRAVITY_API_KEY=
# GRAVITY_BASE_URL: Gravity API base URL. Required alongside GRAVITY_API_KEY when GRAVITY_ENABLED is true.
GRAVITY_BASE_URL=

# --- Dashboard ---
# ADMIN_PASSWORD: password for the dashboard admin login. Change it anywhere but local dev.
ADMIN_PASSWORD=change-me
